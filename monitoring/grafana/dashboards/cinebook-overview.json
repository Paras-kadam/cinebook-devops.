      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cinebook-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cinebook_http_requests_total{job=\"cinebook\",status=~\"4..|5..\"}[$__rate_interval])) or vector(0)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
