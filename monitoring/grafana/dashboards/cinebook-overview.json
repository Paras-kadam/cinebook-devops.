{
  "uid": "cinebook-overview",
  "title": "CineBook Overview",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "tags": [
    "cinebook",
    "devops"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Application availability",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cinebook-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"cinebook\"}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
