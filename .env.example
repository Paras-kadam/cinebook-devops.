# Local Node.js API/production server port; Docker uses internal port 3000.
PORT=3001
# Docker host ports; use these values for the monitoring stack.
APP_PORT=3080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Vite development website port; the proxy automatically follows PORT above.
VITE_PORT=5173
# Local Node.js database; Docker uses its named volume at /app/data instead.
DB_PATH=./data/cinebook.sqlite
# Required by Compose. Set a username and a private password in your shell or .env.
# Leave this committed example blank; never commit actual credentials.
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# Cloud only: Render's Blueprint supplies these. Leave local metrics open only on localhost.
# METRICS_TOKEN=<generate a private random token of at least 32 characters>
# METRICS_REQUIRE_AUTH=true
# REQUIRE_PERSISTENT_DISK=true
# PERSISTENT_DATA_DIR=/app/data
# TRUST_PROXY=1
# REQUEST_LOGGING=true

# Free cloud mode only. Local Docker keeps its existing SQLite named volume.
# DATABASE_PROVIDER=turso
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=<enter privately; never commit>
