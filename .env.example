# Local Node.js API/production server port; Docker uses internal port 3000.
PORT=3001
# Windows port for Docker Compose, independent of PORT above.
APP_PORT=3080
# Vite development website port; the proxy automatically follows PORT above.
VITE_PORT=5173
# Local Node.js database; Docker uses its named volume at /app/data instead.
DB_PATH=./data/cinebook.sqlite
