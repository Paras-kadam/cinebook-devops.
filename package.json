{
  "name": "cinebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local cinema booking application for a college DevOps project.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "node server/index.js --production",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "test:monitoring": "node scripts/test-monitoring.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "^17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "^0.577.0",
    "prom-client": "15.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
